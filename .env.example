# ---- Telegram ----
# توکنی که BotFather می‌دهد
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Database ----
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# برای تست لوکال می‌توانید SQLite بگذارید:
DATABASE_URL=sqlite:///data/gamebot.db

# ---- Gameplay ----
TURN_TIMEOUT=45
LOBBY_TIMEOUT=180

# ---- Webhook (اختیاری؛ اگر خالی باشد حالت polling اجرا می‌شود) ----
WEBHOOK_URL=
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
