{
  "name": "kalame-bazi",
  "version": "1.0.0",
  "description": "کلمه‌بازی — مینی‌اپ پازل کلمات فارسی برای تلگرام (Cloudflare Workers + D1)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "cf:check": "wrangler deploy --dry-run --outdir dist",
    "levels": "python3 scripts/build_levels.py --input data/dictionary.json --out src/data/levels.json --count 400 --max-targets 12 --min-weight 5000 --bonus-min-weight 4000"
  },
  "keywords": ["telegram", "mini-app", "word-game", "cloudflare-workers", "d1"],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=20"
  }
}
