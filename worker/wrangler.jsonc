{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-game-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // دیتابیس D1 — شناسه را از Storage → D1 در پنل کلادفلر بردارید و اینجا بگذارید
  // (نام Worker بالا باید دقیقاً با نام Worker در پنل یکی باشد، وگرنه بیلد fail می‌شود)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-card-games",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // تایمر نوبت‌ها: هر دقیقه میزهای منقضی را خودکار بازی می‌کند
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "BOT_USERNAME": "hydrogameofficialbot",
    "TURN_TIMEOUT": "45",
    "LOBBY_TIMEOUT": "180"
  }
}
