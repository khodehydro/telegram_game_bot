{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-game-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },

  // مینی‌اپ استاتیک از پوشهٔ public سرو می‌شود؛ مسیرهای API/وبهوک به Worker می‌روند
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook", "/setup", "/health"]
  },

  // D1 — شناسه را از Storage → D1 در پنل کلادفلر بردارید
  // (نام Worker بالا باید دقیقاً با نام Worker در پنل یکی باشد، وگرنه بیلد fail می‌شود)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-card-games",
      "database_id": "b9d6376f-d8d0-4192-a724-4b337b38ebb8"
    }
  ],

  "vars": {
    // آدرس عمومی مینی‌اپ (همین Worker). اگر دامنهٔ اختصاصی وصل کردید اینجا را عوض کنید.
    "APP_URL": "https://telegram-game-bot.khodehydro.workers.dev",
    "BOT_USERNAME": "hydrogameofficialbot"
  }
}
